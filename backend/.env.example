# ============================================================
# APPOINTIFY — Backend Environment (template)
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5174

# --- Database (XAMPP MariaDB / MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=appointify

# --- Auth ---
# REQUIRED in production (the API refuses to boot without it).
# In dev, if left blank a machine-local secret is generated at backend/.jwt-secret.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Email (SMTP — leave blank to log emails to console) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@appointify.local

# --- Stripe TEST MODE ---
# Uses test keys; no real charges are ever made.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_MODE=mock
